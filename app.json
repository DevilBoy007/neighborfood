{
  "expo": {
    "name": "neighborfood",
    "slug": "neighborfood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neighborfood",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "store.neighborfood",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "package": "store.neighborfood"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/carrot-notification-icon.png",
          "color": "#87CEFA"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Neighborfood uses your location to show nearby shops and to set your local market."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Neighborfood accesses your photos so you can add pictures of your shop, items, and profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.store.neighborfood",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "80148082-f879-43a9-921b-22da9e39ddd2"
      }
    },
    "owner": "dbakr",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/80148082-f879-43a9-921b-22da9e39ddd2"
    }
  }
}
