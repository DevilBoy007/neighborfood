# ============================================================
# Neighborfood Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ============================================================

# ---- Firebase (client-side) ----
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_AUTH_DOMAIN=
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_STORAGE_BUCKET=

# ---- Stripe (client-side) ----
# Publishable key from https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Stripe (server-side — stored as Firebase Secret Manager secrets) ----
# Set via:  firebase functions:secrets:set STRIPE_SECRET_KEY
#           firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
#
# Webhook signing secret obtained after registering the stripeWebhook endpoint
# in https://dashboard.stripe.com/webhooks
# Events to forward:
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   charge.refunded
#   transfer.created
STRIPE_WEBHOOK_SECRET=whsec_...
