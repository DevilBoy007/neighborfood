# ============================================================
# Neighborfood Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ============================================================

# ---- Firebase (client-side) ----
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_AUTH_DOMAIN=
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_STORAGE_BUCKET=

# ---- Stripe (client-side) ----
# Publishable key from https://dashboard.stripe.com/apikeys
# Development/preview builds must use pk_test_ (debug builds refuse pk_live_).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- RevenueCat (Neighborfood Pro subscriptions) ----
# Public SDK keys: RevenueCat dashboard > Project settings > API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Server-side (Firebase secrets, not in .env):
#   firebase functions:secrets:set REVENUECAT_SECRET_API_KEY   # secret v1 API key (sk_...)
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_AUTH     # random string; set the same
#                                                              # value as the webhook's
#                                                              # Authorization header (Bearer)

# ---- Local Firebase Emulator Suite (development only) ----
# Point Auth, Storage and Cloud Functions at `npm run emulators`.
# Physical devices: set the host to your computer's LAN IP.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# ---- Stripe (server-side — stored as Firebase Secret Manager secrets) ----
# Never prefix server secrets with EXPO_PUBLIC_ (those are bundled into the app).
# Deployed:  firebase functions:secrets:set STRIPE_SECRET_KEY --project <alias>
#            firebase functions:secrets:set STRIPE_WEBHOOK_SECRET --project <alias>
# Emulator:  functions/.secret.local (see functions/.secret.local.example)
#
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
#
# Webhook signing secret obtained after registering the stripeWebhook endpoint
# in https://dashboard.stripe.com/webhooks
# Events to forward:
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   charge.refunded
#   transfer.created
STRIPE_WEBHOOK_SECRET=whsec_...
